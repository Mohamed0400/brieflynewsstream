{
  "crons": [
    {
      "path": "/api/cron/collect",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/archive",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/translate",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/ops-heal",
      "schedule": "0 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/favicon-:size.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/apple-icon.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
