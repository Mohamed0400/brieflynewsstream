# Supabase Postgres — transaction pooler (app runtime, IPv4).
# Vercel/serverless: keep connection_limit=1. Long-running workers may use 5.
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase Postgres — session pooler (migrations)
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Neon cutover (optional) — see docs/NEON-CUTOVER.md ---
# Do not flip AUTH_PROVIDER=neon until DATABASE_URL/DIRECT_URL point at Neon with migrations applied.
# AUTH_PROVIDER="supabase"
# AUTH_PROVIDER="neon"
# DATABASE_URL="postgresql://…@….neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://…@….neon.tech/neondb?sslmode=require"
# NEON_AUTH_BASE_URL="https://….neonauth….aws.neon.tech/neondb/auth"
# NEON_AUTH_COOKIE_SECRET="generate-with-openssl-rand-base64-32"
# NEON_AUTH_JWKS_URL="https://….neonauth….aws.neon.tech/neondb/auth/.well-known/jwks.json"

# Optional: local SQLite path for one-time cutover script
SQLITE_BACKUP_URL="file:./data/live.db"

NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Supabase Auth → URL Configuration. Without these, confirmation links fail.
# Site URL: https://www.brieflynewsstream.com
# Redirect URLs:
#   http://localhost:3000/auth/callback
#   http://localhost:3000/auth/callback**
#   http://localhost:3000/auth/confirm
#   http://localhost:3000/auth/confirm**
#   https://www.brieflynewsstream.com/auth/callback
#   https://www.brieflynewsstream.com/auth/callback**
#   https://www.brieflynewsstream.com/auth/confirm
#   https://www.brieflynewsstream.com/auth/confirm**
#   https://brieflynewsstream.com/auth/confirm**
# Confirm signup email template must use TokenHash (not {{ .ConfirmationURL }}):
#   {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=email&next=/console/overview
# Reset password template:
#   {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=recovery&next=/console/reset-password
# Keep "Confirm email" on. Emails are links, not 6-digit OTPs.

# Comma-separated emails that receive SUPER_ADMIN on first Account create
SUPER_ADMIN_EMAILS="you@example.com"
CONSOLE_E2E_EMAIL="console-e2e@example.com"
CONSOLE_E2E_PASSWORD="replace-with-e2e-password"
# Deterministic account-scoped key for quota smoke/E2E (test env only). Created by npm run auth:ensure-user.
QUOTA_TEST_API_KEY="mna_test_e2e_quota_smoke_do_not_use_in_production"

API_KEY="replace-with-a-long-client-key"
ADMIN_API_KEY="replace-with-a-different-admin-key"
# Vercel Cron / GitHub HTTP bearer. Vercel injects this automatically if set in the project.
CRON_SECRET="replace-with-cron-bearer-token"
# true = run node-cron inside Next.js (DigitalOcean VPS / npm start). Ignored on Vercel unless forced.
ENABLE_EMBEDDED_SCHEDULER=""
# Long-lived Celery-like worker (npm run worker:live) uses pg-boss by default.
# Set to "node-cron" to fall back to the legacy in-process scheduler.
WORKER_SCHEDULER=""
# Optional pg-boss overrides. Falls back to DIRECT_URL, then DATABASE_URL.
# Prefer the direct/session Postgres URL: pg-boss migrates its own schema.
PG_BOSS_DATABASE_URL=""
PG_BOSS_SCHEMA="pgboss"
CONSOLE_SESSION_SECRET="replace-with-a-long-random-session-secret"
GOOGLE_API_KEY=""
GOOGLE_GROUNDED_SEARCH_ENABLED="false"
GOOGLE_EDITORIAL_ENABLED="false"
GEMINI_MODEL="gemini-3.6-flash"
APP_TIMEZONE="Asia/Kuwait"
NEXT_PUBLIC_APP_ENV="test"
# Production (use www — apex redirects to www on Vercel):
# NEXT_PUBLIC_SITE_URL="https://www.brieflynewsstream.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# For Vercel: use local gitignored `.env` or `.env.vercel` (same contents after
# generate from .env.live). See docs/production-blockers.md for import steps.
# Do NOT commit secret env files.



COLLECT_RSS_LIMIT="0"
COLLECT_HTML_LIMIT="0"
COLLECT_SITEMAP_LIMIT="0"
# Cap GNews items per generated feed. High values × 3400+ sources blow Free-plan egress (5 GB).
COLLECT_GNEWS_LIMIT="5"
# Parallel fetches. Prefer 2 on Free; raise only if egress headroom exists.
COLLECT_CONCURRENCY="2"
MIN_COUNTRY_ARTICLES="2"
COLLECT_GEMINI_LIMIT="50"
COLLECT_NATIONALITY_LIMIT="60"
NATIONALITY_SEARCH_INTERVAL_HOURS="12"
NEWS_MAX_AGE_HOURS="72"
SOURCE_HEALTH_MAX_AGE_HOURS="24"
NATIONALITY_NEWS_MAX_AGE_HOURS="48"
NATIONALITY_FEED_LIMIT="12"
NORMALIZE_BATCH_SIZE="0"
DAILY_CANDIDATE_POOL="0"
DAILY_EDITION_SIZE="20"
DAILY_REGION_CAP="0"
API_DEFAULT_LIMIT="50"
API_MAX_LIMIT="500"
DASHBOARD_LIMIT="50"
TRANSLATE_BATCH_SIZE="40"
EDITIONS_LIST_LIMIT="90"

# Main bilingual collect kill switch. Under egress pressure: set false FIRST; keep Arabic on.
# docs/EGRESS-GUARD.md
MAIN_COLLECT_ENABLED="true"

# Arabic-only collect pipeline (separate from bilingual ingest — no Gemini)
# ~981 Arabic sources. Leave disabled locally; GHA enables it.
# Kill switch (last resort): ARABIC_COLLECT_ENABLED=false — pause MAIN first.
ARABIC_COLLECT_ENABLED="false"
ARABIC_COLLECT_FORCE="false"
ARABIC_COLLECT_CONCURRENCY="3"
ARABIC_COLLECT_BUDGET_MS="900000"
ARABIC_COLLECT_REFRESH_HOURS="4"

# Cloudinary (image optimization + uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_URL="cloudinary://your-api-key:your-api-secret@your-cloud-name"
# Required for client-side optimized delivery (same as CLOUDINARY_CLOUD_NAME)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Payment provider — Lemon Squeezy (merchant of record)
BILLING_PROVIDER="lemonsqueezy"
# Set true + use Test-mode API keys from Lemon Squeezy dashboard (toggle bottom-left) so checkout accepts test cards.
LEMONSQUEEZY_TEST_MODE="false"
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_VARIANT_ID=""
LEMONSQUEEZY_ENTERPRISE_VARIANT_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
# Test cards (4242…) only work with Test-mode keys above — not live production keys.
# Webhook: https://www.brieflynewsstream.com/api/webhooks/billing/lemonsqueezy
# Enable: order_created, subscription_created, subscription_payment_success,
#   subscription_payment_recovered, subscription_cancelled, subscription_expired,
#   subscription_payment_failed, subscription_resumed, subscription_updated
# Cancel keeps Pro until period end; subscription_expired sets plan Free.

# Hot retention in Supabase (days). Default 5 keeps free-plan DB (~500 MB) in check.
# Use at least 4–5 when NEWS_MAX_AGE_HOURS=72 so archive does not prune the live feed edge.
# Without R2, older rows are deleted. With R2, they are archived first — docs/R2-CLOUDFLARE-SETUP.md
ARCHIVE_HOT_RETENTION_DAYS="5"
# Processed RawArticle rows (post-normalize). Keep short — rawJson churn caused exceed_egress_quota.
ARCHIVE_RAW_RETENTION_DAYS="2"
# Cloudflare R2 cold archive (optional — app works without these)
# Enable R2 in the Cloudflare dashboard first, create bucket + API token, then set:
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="briefly-newsstream-archive"
# Optional override; default is https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ENDPOINT=""
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_PRO_MONTHLY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
